---
const { title, mainClass = '' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} | موسوعة النصيرية والعلويين</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
<style is:global>
:root{
  --bg:#f4eee0; --paper:#fffdf6; --ink:#2c2314; --acc:#7a4416; --acc2:#9a5f22;
  --gold:#b8893b; --mut:#8b7a60; --line:#e2d6bc; --soft:#efe6d0;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.95 "Amiri","Noto Naskh Arabic",Tahoma,serif;
  background-image:radial-gradient(ellipse at top, rgba(184,137,59,.07), transparent 55%)}
a{color:var(--acc)}
a:hover{color:var(--acc2)}

/* ===== header ===== */
header{position:sticky;top:0;z-index:50;background:rgba(244,238,224,.92);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);box-shadow:0 1px 0 rgba(184,137,59,.25), 0 6px 18px -14px rgba(60,40,10,.4);
  padding:10px 22px;display:flex;gap:20px;flex-wrap:wrap;align-items:baseline}
header a{color:var(--acc);text-decoration:none;font-size:16px}
header a:hover{color:var(--acc2);text-decoration:underline;text-underline-offset:4px}
header .t{font-family:"Aref Ruqaa","Amiri",serif;font-size:25px;color:var(--ink);line-height:1.3}
header nav{display:flex;gap:18px;flex-wrap:wrap}

main{max-width:920px;margin:0 auto;padding:28px 22px 70px;overflow-x:hidden}
main.read{max-width:780px}
main.wide{max-width:1180px}

h1{font-size:30px;line-height:1.5;margin:.15em 0 .4em;color:#241c0e}
h2{font-size:23px;color:var(--acc);margin:2.2em 0 .7em;display:flex;align-items:center;gap:14px;scroll-margin-top:96px}
h2::before{content:"❧";color:var(--gold);font-size:19px}
h2::after{content:"";flex:1;height:1px;background:linear-gradient(to left, var(--line), transparent)}
p{margin:.45em 0 1em}

.note{background:#fdf4dd;border:1px solid #e6cf9a;border-right:4px solid var(--gold);padding:10px 16px;border-radius:8px;font-size:15.5px;color:#5d4a22}
.mut{color:var(--mut);font-size:14.5px}
.tag{display:inline-block;background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:0 9px;font-size:13px;color:var(--acc)}

table{width:100%;border-collapse:collapse;font-size:14.5px;background:var(--paper);border-radius:10px;overflow:hidden;box-shadow:0 1px 4px rgba(80,55,15,.08)}
th{background:var(--soft);color:#5d4a22;font-weight:700}
td,th{border-bottom:1px solid var(--line);padding:8px 10px;text-align:right;vertical-align:top}
tr:last-child td{border-bottom:none}

input[type=search],input.f{width:100%;padding:11px 14px;font:inherit;font-size:16px;border:1px solid var(--line);border-radius:10px;background:var(--paper);margin-bottom:14px}
input[type=search]:focus,input.f:focus{outline:2px solid var(--gold);outline-offset:1px}

footer{border-top:1px solid var(--line);margin-top:40px;padding:18px 22px 30px;text-align:center;color:var(--mut);font-size:14px}
footer a{color:var(--mut)}

/* ===== article ===== */
.kicker{font-size:19px;color:var(--acc2);margin:-.2em 0 .6em}
.meta{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:.2em 0 1em;font-size:15px;color:var(--mut)}
.meta .tag{background:var(--paper)}
.srccard{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:10px 16px;font-size:15px;margin:0 0 1.4em;overflow-wrap:anywhere}
.article-wrap{display:grid;grid-template-columns:1fr 240px;gap:34px;align-items:start}
.toc{position:sticky;top:92px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px 16px;font-size:15px;box-shadow:0 1px 5px rgba(80,55,15,.07)}
.toc .tt{font-weight:700;color:var(--acc);border-bottom:1px solid var(--line);padding-bottom:6px;margin-bottom:8px}
.toc ol{margin:0;padding:0 18px 0 0;list-style:none;counter-reset:s;max-height:68vh;overflow:auto}
.toc li{counter-increment:s;margin:.3em 0;line-height:1.55}
.toc li::before{content:counter(s,arabic-indic) ". ";color:var(--gold)}
.toc a{color:var(--ink);text-decoration:none}
.toc a:hover{color:var(--acc)}
.toc a.act{color:var(--acc);font-weight:700}
@media (max-width:900px){
  .article-wrap{grid-template-columns:1fr}
  .toc{position:static;order:-1}
}
.body p{text-align:justify}
.body p.lede::first-letter{font-size:2.6em;line-height:1;color:var(--acc);font-weight:700;padding-inline-end:6px}
.pg{display:inline-block;background:#f0e7d2;color:#8a6d3b;border-radius:5px;padding:0 7px;font-size:13.5px;margin:0 2px;white-space:nowrap}
.fn{font-size:15.5px;color:#5c4e36;padding-inline-start:1.5em;text-indent:-1.5em;text-align:right !important}
.tocbtn{display:none}
@media (max-width:900px){ .tocbtn{display:block} }
</style>
</head>
<body>
<header>
  <a class="t" href={b+'/'}>موسوعة النصيرية والعلويين</a>
  <nav>
    <a href={b+'/texts/'}>النصوص</a>
    <a href={b+'/places/'}>الأماكن</a>
    <a href={b+'/people/'}>الأشخاص</a>
    <a href={b+'/dates/'}>التواريخ</a>
    <a href={b+'/photos/'}>الصور</a>
    <a href={b+'/search/'}>بحث</a>
    <a href={b+'/about/'}>عن المشروع</a>
  </nav>
</header>
<main class={mainClass} data-pagefind-body><slot/></main>
<footer>
  موسوعة النصيرية والعلويين · أرشيف نصوص وفهارس، مواد في الملك العام ما لم يُذكر خلافه · {year}
  <div style="margin-top:6px">الموسوعة من جمع وتأصيل وترجمة وتحقيق إياد خضر صالح</div>
</footer>
</body>
</html>
