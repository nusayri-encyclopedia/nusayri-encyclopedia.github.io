---
import L from '../../layouts/L.astro';import photos from '../../data/photos.json';
const th=(id,w)=>'https://drive.google.com/thumbnail?id='+id+'&sz=w'+w;
const ncol=photos.filter(p=>p.c).length;
---
<L title="الصور"><h1>الصور</h1>
<p class="note">{photos.length} صورة موثّقة المصدر والرخصة. يظهر الأصل أولاً؛ وحيث تتوفر نسخة ملوّنة آليًا ({ncol} صورة) يمكن عرضها بالزر، وهي تُنشر برخصة CC BY-SA 4.0 مع إسناد الأصل نفسه. النقر على الصورة يفتح نسخة أكبر.</p>
<style>
#g{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
#g figure{margin:0;background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden}
#g img{width:100%;display:block;background:#eee}
#g figcaption{padding:8px 10px;font-size:14px;line-height:1.7}
#g a{color:var(--acc)}
.tg{margin-top:4px;padding:3px 12px;font:inherit;font-size:13px;border:1px solid var(--acc);border-radius:6px;background:#efe5d0;color:var(--acc);cursor:pointer}
.cc{color:var(--acc);font-size:12px}
</style>
<div id="g">
{photos.map(p=><figure data-o={p.o} data-c={p.c||''}>
<a href={th(p.o,1600)} target="_blank" rel="noopener"><img src={th(p.o,600)} alt={p.title} loading="lazy"/></a>
<figcaption><b>{p.title}</b><br/><span class="mut">{p.date}{p.photographer?' · '+p.photographer:''} · {p.archive}</span><br/>
{p.license_link?<a href={p.license_link} target="_blank" rel="noopener">{p.license}</a>:p.license}{p.source_url&&p.source_url!==p.license_link?<> · <a href={p.source_url} target="_blank" rel="noopener">صفحة المصدر</a></>:null}
{p.c&&<button class="tg">عرض النسخة الملوّنة</button>}<span class="cc" style="display:none"><br/>تلوين آلي للأصل — يُنشر برخصة CC BY-SA 4.0 مع إسناد المصوّر والمصدر نفسهما أعلاه</span>
</figcaption></figure>)}
</div>
<script is:inline>
const th=(id,w)=>'https://drive.google.com/thumbnail?id='+id+'&sz=w'+w;
document.querySelectorAll('#g figure').forEach(f=>{
  const btn=f.querySelector('.tg');if(!btn)return;
  const img=f.querySelector('img'),a=f.querySelector('a'),cc=f.querySelector('.cc');let col=false;
  btn.onclick=()=>{col=!col;const id=col?f.dataset.c:f.dataset.o;img.src=th(id,600);a.href=th(id,1600);cc.style.display=col?'inline':'none';btn.textContent=col?'عرض الأصل':'عرض النسخة الملوّنة'};
});
</script>
</L>
