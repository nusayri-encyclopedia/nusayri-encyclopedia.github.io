---
import L from '../../layouts/L.astro';import data from '../../data/dates.json';
const rows=data.slice(0,3000);
---
<L title="التواريخ"><h1>التواريخ</h1><p class="note">استخراج آلي، كل المدخلات «غير مؤكد» حتى تُراجع مع الصفحة والمصدر.</p>
<input class="f" id="q" placeholder="ابحث"><table id="t"><thead><tr><th>السنة</th><th>الذكر</th><th>الملفات</th><th>الحالة</th></tr></thead><tbody>
{rows.map(r=><tr><td>{r.year}</td><td>{r.n}</td><td>{r.files}</td><td><span class="tag">غير مؤكد</span></td></tr>)}
</tbody></table><p class="mut">{rows.length} مدخل</p>
<script is:inline>const q=document.getElementById('q');q.oninput=()=>{const v=q.value.trim();document.querySelectorAll('#t tbody tr').forEach(r=>r.style.display=r.textContent.includes(v)?'':'none')}</script></L>
