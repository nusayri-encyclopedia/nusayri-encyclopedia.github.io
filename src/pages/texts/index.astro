---
import L from '../../layouts/L.astro';
import texts from '../../data/texts.json';
import fs from 'node:fs';
import { yearLabel } from '../../lib/hijri';
const full = new Set(JSON.parse(fs.readFileSync('src/data/fulltexts.json','utf-8')).map((x)=>x.id));
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows=[...texts].sort((a,b)=>(a.year||'9999').localeCompare(b.year||'9999'));
const pub = rows.filter(r=>full.has(r.id)).length;
---
<L title="سجل النصوص">
<h1>سجل النصوص</h1>
<p class="mut">{rows.length} مصدرًا مرتبة زمنيًا حسب سنة التأليف المرشحة، منها {pub} منشورًا بنصه الكامل. التاريخ الهجري مقابِل تقريبي محسوب.</p>
<input class="f" id="q" placeholder="ابحث في السجل بالاسم أو السنة">
<div id="t">
{rows.map(r=>(
  <div class="it" style="border-bottom:1px solid var(--line);padding:10px 4px;overflow-wrap:anywhere">
    <div>
      {full.has(r.id)
        ? <a href={b+'/texts/'+r.id+'/'} style="font-weight:700;font-size:18.5px;text-decoration:none">{r.name}</a>
        : <span style="font-size:18.5px">{r.name}</span>}
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:2px">
      {r.year && <span class="tag" title="التاريخ الهجري مقابل تقريبي">{yearLabel(r.year)}</span>}
      {full.has(r.id)
        ? <span class="tag">منشور (ما قبل 1920)</span>
        : r.cleared
        ? <span class="tag">قيد الإضافة</span>
        : <span class="tag">محجوب لحين التحقق</span>}
    </div>
  </div>
))}
</div>
<script is:inline>const q=document.getElementById('q');q.oninput=()=>{const v=q.value.trim();document.querySelectorAll('#t .it').forEach(r=>r.style.display=r.textContent.includes(v)?'':'none')}</script>
</L>
